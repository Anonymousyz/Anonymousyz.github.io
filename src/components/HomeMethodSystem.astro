---
import '../styles/homepage-method-system.css';

const { relationships } = Astro.props;
---

<div class="home-method-system">
  <div class="home-method-system__paths">
    {relationships.paths.map((path) => (
      <section class="home-method-path" aria-labelledby={`${path.key}-title`}>
        <header class="home-method-path__head">
          <span>{path.label}</span>
          <h3 id={`${path.key}-title`}>{path.title}</h3>
        </header>
        <div class="home-method-path__content">
          <ol>
            {path.items.map((item, index) => (
              <li>
                <a href={item.href}>{item.title}</a>
                {index < path.items.length - 1 && <span aria-hidden="true">→</span>}
              </li>
            ))}
          </ol>
          <p class="home-method-path__route"><span>{path.from}</span><span aria-hidden="true">→</span><span>{path.to}</span></p>
        </div>
      </section>
    ))}
  </div>

  <a class="home-method-system__learning" href="/methods/learning/">
    <span>{relationships.learning}</span>
    <span aria-hidden="true">→</span>
  </a>

  <a class="home-method-system__all text-link" href="/methods/">
    查看 7 项工作方法 <span aria-hidden="true">→</span>
  </a>
</div>